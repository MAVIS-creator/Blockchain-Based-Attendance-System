[Unit]
Description=BBAS post-attendance synchronization worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bbas
Group=bbas
WorkingDirectory=/srv/bbas/app
ExecStart=/usr/bin/bash -c 'while true; do /usr/bin/php admin/post_submit_worker.php --drain=20; sleep 3; done'
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/bbas/data

[Install]
WantedBy=multi-user.target
