# High-Q Solid Academy Biometric Attendance System - Apache Configuration

# Disable directory browsing
Options -Indexes

# Protect .env files
<FilesMatch "^\.env(\..*)?$">
    Require all denied
</FilesMatch>

# Protect sensitive files and configs
<FilesMatch "\.(log|bak|lock|ps1|bat|md)$">
    Require all denied
</FilesMatch>
