<Window x:Class="HighQBiometricService.TrayStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="High-Q Biometric Service" Height="380" Width="320"
        WindowStartupLocation="Manual" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" Deactivated="Window_Deactivated">
    <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#C3C6D7" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.12" Direction="270" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0D1C2E" CornerRadius="11,11,0,0" Padding="16,12">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="4" Background="#004AC6" Margin="0,0,8,0">
                            <TextBlock Text="🖐️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="High-Q Biometric" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Click="BtnClose_Click" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" 
                            FontSize="14" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Status Body -->
            <StackPanel Grid.Row="1" Margin="16,12">
                <!-- Service Status Row -->
                <Border Background="#F8F9FB" BorderBrush="#E1E2E4" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#004AC6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Service Status" FontSize="12" Foreground="#434655"/>
                        </StackPanel>
                        <TextBlock Text="🟢 Running" FontSize="12" FontWeight="Bold" Foreground="#191C1E" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <!-- Scanner Row -->
                <Border Background="#F8F9FB" BorderBrush="#E1E2E4" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔌" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Scanner" FontSize="12" Foreground="#434655"/>
                        </StackPanel>
                        <TextBlock Text="🟢 U.are.U 5160" FontSize="12" FontWeight="Bold" Foreground="#004AC6" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <!-- API Ready Row -->
                <Border Background="#F8F9FB" BorderBrush="#E1E2E4" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Local API" FontSize="12" Foreground="#434655"/>
                        </StackPanel>
                        <TextBlock Text="🟢 Ready (8080)" FontSize="12" FontWeight="Bold" Foreground="#191C1E" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <!-- Quick Action Buttons Grid -->
                <UniformGrid Columns="2" Rows="2">
                    <Button Content="📊 Open Dashboard" Click="BtnDashboard_Click" Margin="0,0,4,4" Padding="8,6" Background="#004AC6" Foreground="White" FontWeight="SemiBold" FontSize="11" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="🔬 Test Scanner" Click="BtnTestScanner_Click" Margin="4,0,0,4" Padding="8,6" Background="#F3F4F6" Foreground="#191C1E" FontWeight="SemiBold" FontSize="11" BorderBrush="#C3C6D7" BorderThickness="1">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="↗ Open Attendance" Click="BtnAttendance_Click" Margin="0,4,4,0" Padding="8,6" Background="#F3F4F6" Foreground="#191C1E" FontWeight="SemiBold" FontSize="11" BorderBrush="#C3C6D7" BorderThickness="1">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="🔄 Restart Service" Click="BtnRestart_Click" Margin="4,4,0,0" Padding="8,6" Background="#F3F4F6" Foreground="#191C1E" FontWeight="SemiBold" FontSize="11" BorderBrush="#C3C6D7" BorderThickness="1">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </UniformGrid>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8F9FB" BorderBrush="#E1E2E4" BorderThickness="0,1,0,0" Padding="12,8" CornerRadius="0,0,11,11">
                <DockPanel>
                    <Button Content="⚙️ Settings" Click="BtnSettings_Click" Foreground="#515F74" Background="Transparent" BorderThickness="0" FontSize="11"/>
                    <Button Content="🚪 Exit Service" Click="BtnExit_Click" Foreground="#BA1A1A" Background="Transparent" BorderThickness="0" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
