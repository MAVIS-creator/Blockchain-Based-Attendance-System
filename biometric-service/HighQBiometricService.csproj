<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Title>High-Q Biometric Service</Title>
    <Company>High-Q Solid Academy</Company>
    <Product>High-Q Solid Academy Biometric Attendance System</Product>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Reference DigitalPersona SDK DLLs from Digital-Persona-U.are.U-SDK-master directory if available -->
  <ItemGroup>
    <Reference Include="DPUruNet">
      <HintPath>..\Digital-Persona-U.are.U-SDK-master\Windows\Lib\DPUruNet.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
