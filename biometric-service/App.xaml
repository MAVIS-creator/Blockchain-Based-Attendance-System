<Application x:Class="HighQBiometricService.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="SplashWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryNavy">#0B1C30</Color>
            <Color x:Key="AccentGold">#FDC014</Color>
            <Color x:Key="DarkSurface">#0F172A</Color>
            <Color x:Key="CardSurface">#1E293B</Color>
            <Color x:Key="TextWhite">#F8FAFC</Color>
            <Color x:Key="TextMuted">#94A3B8</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
