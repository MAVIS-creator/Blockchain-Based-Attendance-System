<Window x:Class="HighQBiometricService.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="High-Q Biometric Service Setup" Height="520" Width="760"
        WindowStartupLocation="CenterScreen" Background="#F8F9FB"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar (Matching Stitch Installer Sidebar) -->
        <Border Grid.Column="0" Background="#0D1C2E">
            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="24,24,24,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="32" Height="32" CornerRadius="6" Background="#004AC6" Margin="0,0,10,0">
                            <TextBlock Text="🖐️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="High-Q" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Biometric Service" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>

                <!-- Sidebar Graphic Container -->
                <Border Margin="16" Background="#1E293B" CornerRadius="8" Padding="16" VerticalAlignment="Bottom">
                    <StackPanel>
                        <TextBlock Text="🔒 Enterprise Security" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="DigitalPersona U.are.U 5160 Biometric Bridge" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Right Main Canvas (Wizard Steps Container) -->
        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- STEP 1: WELCOME SCREEN -->
            <Grid x:Name="Step1_Welcome" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Welcome to High-Q Biometric Service" FontSize="22" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,12"/>
                    <TextBlock Text="Install the biometric companion service required to connect your fingerprint scanner to the High-Q Attendance System." FontSize="13" Foreground="#434655" TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <Border Background="#F9FAFB" BorderBrush="#C3C6D7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                        <StackPanel>
                            <Border Padding="0,6" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="Version" FontSize="12" Foreground="#434655"/>
                                    <TextBlock Text="1.0.0" FontSize="12" FontWeight="Bold" Foreground="#191C1E" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border Padding="0,6" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="Publisher" FontSize="12" Foreground="#434655"/>
                                    <TextBlock Text="High-Q Solid Academy" FontSize="12" FontWeight="Bold" Foreground="#191C1E" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border Padding="0,6">
                                <DockPanel>
                                    <TextBlock Text="Supported Platform" FontSize="12" Foreground="#434655"/>
                                    <TextBlock Text="Windows 10 / 11 (64-bit)" FontSize="12" FontWeight="Bold" Foreground="#004AC6" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="🔒" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Your biometric templates remain protected and are never displayed in this application." FontSize="12" Foreground="#434655" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- STEP 2: SYSTEM CHECK SCREEN -->
            <Grid x:Name="Step2_SystemCheck" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Checking your computer" FontSize="22" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,4"/>
                    <TextBlock Text="We're checking that this computer is ready for High-Q Biometric Service." FontSize="13" Foreground="#434655" Margin="0,0,0,20"/>

                    <StackPanel Margin="0,0,0,16">
                        <Border Background="#F9FAFB" BorderBrush="#E1E2E4" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock Text="Windows compatibility" FontSize="13" Foreground="#191C1E"/>
                                <TextBlock Text="🟢 Compatible" FontSize="12" FontWeight="Bold" Foreground="#166534" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>

                        <Border Background="#F9FAFB" BorderBrush="#E1E2E4" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock Text=".NET Runtime 8.0" FontSize="13" Foreground="#191C1E"/>
                                <TextBlock Text="🟢 Installed" FontSize="12" FontWeight="Bold" Foreground="#166534" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>

                        <Border Background="#F9FAFB" BorderBrush="#E1E2E4" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock Text="DigitalPersona Runtime" FontSize="13" Foreground="#191C1E"/>
                                <TextBlock Text="🟢 Ready" FontSize="12" FontWeight="Bold" Foreground="#166534" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>

                        <Border Background="#F9FAFB" BorderBrush="#E1E2E4" BorderThickness="1" CornerRadius="6" Padding="12">
                            <DockPanel>
                                <TextBlock Text="DigitalPersona SDK Components" FontSize="13" Foreground="#191C1E"/>
                                <TextBlock Text="🟢 Ready" FontSize="12" FontWeight="Bold" Foreground="#166534" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Warning Card -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="🟠 Fingerprint Scanner (Optional during setup)" FontSize="12" FontWeight="Bold" Foreground="#92400E"/>
                            <TextBlock Text="Your fingerprint reader isn't connected right now. You can connect it after installation." FontSize="11" Foreground="#78350F" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- STEP 3: PROGRESS SCREEN -->
            <Grid x:Name="Step3_Progress" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Installing High-Q Biometric Service" FontSize="22" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtProgressStatus" Text="Copying application files..." FontSize="13" Foreground="#434655" Margin="0,0,0,16"/>

                    <ProgressBar x:Name="InstallProgressBar" Height="8" Minimum="0" Maximum="100" Value="10" Foreground="#004AC6" Background="#E1E2E4" BorderThickness="0" Margin="0,0,0,24"/>

                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="✓ Preparing installation" FontSize="12" Foreground="#166534" Margin="0,4"/>
                        <TextBlock x:Name="TxtStepFiles" Text="⏳ Installing application files" FontSize="12" Foreground="#191C1E" Margin="0,4"/>
                        <TextBlock x:Name="TxtStepDlls" Text="⚪ Registering biometric components" FontSize="12" Foreground="#94A3B8" Margin="0,4"/>
                        <TextBlock x:Name="TxtStepService" Text="⚪ Configuring local API (http://localhost:8080)" FontSize="12" Foreground="#94A3B8" Margin="0,4"/>
                        <TextBlock x:Name="TxtStepShortcut" Text="⚪ Creating Windows shortcuts" FontSize="12" Foreground="#94A3B8" Margin="0,4"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- STEP 4: COMPLETE SCREEN -->
            <Grid x:Name="Step4_Complete" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#DCFCE7" Margin="0,0,12,0">
                            <TextBlock Text="✓" Foreground="#166534" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="High-Q Biometric Service is ready" FontSize="20" FontWeight="Bold" Foreground="#191C1E"/>
                            <TextBlock Text="Installation completed successfully." FontSize="13" Foreground="#166534"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,8,0,20">
                        <TextBlock Text="🟢 Application Installed" FontSize="12" FontWeight="SemiBold" Foreground="#191C1E" Margin="0,4"/>
                        <TextBlock Text="🟢 Windows Service &amp; Startup Configured" FontSize="12" FontWeight="SemiBold" Foreground="#191C1E" Margin="0,4"/>
                        <TextBlock Text="🟢 Local API Configured on Port 8080" FontSize="12" FontWeight="SemiBold" Foreground="#191C1E" Margin="0,4"/>
                        <TextBlock Text="🟠 Fingerprint Scanner (Connect U.are.U 5160 when ready)" FontSize="12" FontWeight="SemiBold" Foreground="#92400E" Margin="0,4"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <CheckBox x:Name="ChkLaunchApp" Content="Launch High-Q Biometric Service" IsChecked="True" FontSize="13" FontWeight="SemiBold" Foreground="#191C1E" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkOpenWeb" Content="Open High-Q Attendance Website" IsChecked="True" FontSize="13" FontWeight="SemiBold" Foreground="#191C1E"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Bottom Navigation Bar -->
            <Border Grid.Row="1" BorderBrush="#E1E2E4" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <DockPanel>
                    <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Background="#F8F9FB" Foreground="#004AC6" BorderBrush="#C3C6D7" BorderThickness="1" Padding="20,8" FontWeight="SemiBold" FontSize="12">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BtnNext" Content="Next →" Click="BtnNext_Click" Background="#004AC6" Foreground="White" Padding="24,8" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
