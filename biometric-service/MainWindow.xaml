<Window x:Class="HighQBiometricService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="High-Q Biometric Service" Height="700" Width="1120"
        WindowStartupLocation="CenterScreen" Background="#F8F9FB"
        Icon="biometric_service desktop icon.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar (Matching Stitch UI SideNavBar Component) -->
        <Border Grid.Column="0" Background="#0D1C2E">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="24,24,24,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="32" Height="32" CornerRadius="6" Background="#004AC6" Margin="0,0,10,0">
                            <TextBlock Text="🖐️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="High-Q Biometric" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="v1.0.0-stable" Foreground="#94A3B8" FontSize="12" Margin="42,0,0,0"/>
                </StackPanel>

                <!-- Footer Support & Status -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <Border Background="#004AC6" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Service Running" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="8,0,8,8">
                        <TextBlock Text="❓ Support" Foreground="#CBD5E1" FontSize="12" Margin="0,4"/>
                        <TextBlock Text="📜 View Logs" Foreground="#CBD5E1" FontSize="12" Margin="0,4"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Margin="0,10,0,0">
                    <Border Background="#1E293B" Margin="0,2" Padding="20,12" BorderThickness="4,0,0,0" BorderBrush="#004AC6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Overview" Foreground="#004AC6" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Margin="0,2" Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔌" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Scanner" Foreground="#E2E8F0" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Margin="0,2" Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👆" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Fingerprint Test" Foreground="#E2E8F0" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Margin="0,2" Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💚" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Service Status" Foreground="#E2E8F0" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Margin="0,2" Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Activity Logs" Foreground="#E2E8F0" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Margin="0,2" Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" Foreground="#E2E8F0" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Margin="0,2" Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="About" Foreground="#E2E8F0" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Main Container -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar (Matching Stitch UI TopNavBar) -->
            <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1" Padding="24,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="Biometric Service" FontSize="18" FontWeight="Bold" Foreground="#191C1E" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Diagnostic Mode" Foreground="#434655" FontSize="13" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Terminal" Foreground="#434655" FontSize="13" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <Border Width="1" Height="20" Background="#C3C6D7" Margin="0,0,20,0"/>
                        <TextBlock Text="🔔" FontSize="16" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Canvas Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32">
                    <!-- Section Title -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="High-Q Biometric Service" FontSize="28" FontWeight="Bold" Foreground="#191C1E"/>
                        <TextBlock Text="Fingerprint hardware bridge for High-Q Attendance." FontSize="14" Foreground="#434655" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Bento Grid Layout -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Service Running -->
                        <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E1E2E4" BorderThickness="1" Padding="24" Margin="0,0,12,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#E0F2FE" BorderBrush="#004AC6" BorderThickness="2" Margin="0,0,16,0">
                                        <TextBlock Text="✓" Foreground="#004AC6" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Service Running" FontSize="20" FontWeight="Bold" Foreground="#191C1E"/>
                                        <TextBlock Text="All core processes active" FontSize="13" Foreground="#515F74"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                        <TextBlock Text="Service Status" FontSize="12" FontWeight="SemiBold" Foreground="#434655"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="8" Height="8" Fill="#004AC6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Running" FontSize="14" FontWeight="SemiBold" Foreground="#191C1E"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                        <TextBlock Text="API Status" FontSize="12" FontWeight="SemiBold" Foreground="#434655"/>
                                        <TextBlock Text="Online" FontSize="14" FontWeight="SemiBold" Foreground="#191C1E" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Port Binding" FontSize="12" FontWeight="SemiBold" Foreground="#434655"/>
                                        <Border Background="#F3F4F6" BorderBrush="#E1E2E4" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <TextBlock Text="http://localhost:8080" FontFamily="Consolas" FontSize="12" Foreground="#191C1E"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Version / Uptime" FontSize="12" FontWeight="SemiBold" Foreground="#434655"/>
                                        <TextBlock Text="1.0.0 • Active" FontSize="14" Foreground="#191C1E" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Scanner Connected -->
                        <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E1E2E4" BorderThickness="1" Padding="24" Margin="12,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse Width="8" Height="8" Fill="#004AC6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Scanner Connected" FontSize="12" FontWeight="Bold" Foreground="#004AC6"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtReaderName" Text="DigitalPersona U.are.U 5160" FontSize="18" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,16"/>

                                <StackPanel>
                                    <Border Padding="0,8" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <TextBlock Text="Connection" FontSize="13" Foreground="#434655"/>
                                            <TextBlock Text="USB 3.0" FontSize="12" FontWeight="SemiBold" Foreground="#191C1E" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </Border>

                                    <Border Padding="0,8" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <TextBlock Text="Driver" FontSize="13" Foreground="#434655"/>
                                            <TextBlock Text="Installed (v3.2.1)" FontSize="12" FontWeight="SemiBold" Foreground="#191C1E" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </Border>

                                    <Border Padding="0,8">
                                        <DockPanel>
                                            <TextBlock Text="SDK Status" FontSize="13" Foreground="#434655"/>
                                            <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <TextBlock Text="Ready" FontSize="12" FontWeight="Bold" Foreground="#004AC6"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Terminal Logs Console -->
                    <Border Background="#0D1C2E" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="16" Margin="0,0,0,24">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="LIVE SERVICE TERMINAL LOGS" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ScrollViewer x:Name="LogScrollViewer" Height="140" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" 
                                         FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Bottom Action Buttons (Matching Stitch UI Action Bar) -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🔬 Test Scanner" Click="BtnSimulate_Click" Background="#004AC6" Foreground="White" FontWeight="Bold" Padding="24,10" BorderThickness="0" Margin="0,0,16,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="↗ Open Attendance System" Click="BtnOpenSystem_Click" Background="Transparent" Foreground="#191C1E" FontWeight="SemiBold" Padding="20,10" BorderBrush="#C3C6D7" BorderThickness="1">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
