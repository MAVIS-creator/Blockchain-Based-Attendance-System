<Window x:Class="HighQBiometricService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="High-Q Biometric Service" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#F8FAFB"
        Icon="biometric_service desktop icon.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="#0D1C2E">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="24,24,24,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="32" Height="32" CornerRadius="6" Background="#004AC6" Margin="0,0,10,0">
                            <TextBlock Text="HQ" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="High-Q Biometric" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="v1.0.0-stable" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>

                <!-- Footer Status -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <Border Background="#1E293B" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0"/>
                            <TextBlock Text="Service Running (8080)" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="High-Q Solid Academy &copy; 2026" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Margin="0,10,0,0">
                    <Border Background="#004AC6" Margin="0,2" Padding="20,10" BorderThickness="4,0,0,0" BorderBrush="#FDC014">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Overview" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Margin="0,2" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔌" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Scanner (DigitalPersona 5160)" Foreground="#CBD5E1" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Margin="0,2" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👆" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Fingerprint Test" Foreground="#CBD5E1" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Margin="0,2" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Activity Logs" Foreground="#CBD5E1" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Margin="0,2" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" Foreground="#CBD5E1" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Title Bar -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="High-Q Biometric Service" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Biometric hardware bridge for High-Q Attendance Management System" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Status Bento Grid -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: Service Running -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#DCFCE7" Margin="0,0,12,0">
                                <TextBlock Text="✓" Foreground="#166534" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Service Running" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="All core processes active on http://localhost:8080" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="SERVICE STATUS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="🟢 Active" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="PORT BINDING" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="http://localhost:8080" FontSize="13" FontWeight="SemiBold" Foreground="#004AC6" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="TOTAL SCANS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtTotalScans" Text="0 Scans" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="UPTIME" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="100% Stable" FontSize="13" FontWeight="SemiBold" Foreground="#166534" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Card: Scanner Connection -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24" Margin="12,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SCANNER CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#004AC6"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtReaderName" Text="DigitalPersona U.are.U 5160" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <StackPanel Margin="0,4,0,0">
                            <DockPanel Margin="0,4">
                                <TextBlock Text="Connection" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="USB 3.0" FontSize="12" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="Driver" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="Installed (v3.2.1)" FontSize="12" FontWeight="Bold" Foreground="#166534" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="SDK Status" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="Ready" FontSize="12" FontWeight="Bold" Foreground="#004AC6" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Activity Logs Panel -->
            <Border Grid.Row="2" Background="#020617" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LIVE BIOMETRIC LOGS" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" 
                                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Minimize to Tray" Click="BtnMinimize_Click" Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="16,10" BorderThickness="0" Margin="0,0,12,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Test Fingerprint Touch" Click="BtnSimulate_Click" Background="#004AC6" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
