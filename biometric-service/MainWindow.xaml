<Window x:Class="HighQBiometricService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="High-Q Biometric Service" Height="700" Width="1120"
        WindowStartupLocation="CenterScreen" Background="#F8F9FB">
    <Window.Resources>
        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" Margin="0,1"
                                BorderThickness="4,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1A2A3F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarBtnActive" TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="#1E293B" 
                                Padding="{TemplateBinding Padding}" Margin="0,1"
                                BorderThickness="4,0,0,0" BorderBrush="#004AC6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="#0D1C2E">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="24,24,24,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="32" Height="32" CornerRadius="6" Background="#004AC6" Margin="0,0,10,0">
                            <TextBlock Text="🖐️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="High-Q Biometric" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="v1.0.0-stable" Foreground="#94A3B8" FontSize="12" Margin="42,0,0,0"/>
                </StackPanel>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <Border Background="#004AC6" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonDown="NavServiceStatus_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Service Running" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="8,0,8,8">
                        <TextBlock Text="❓ Support" Foreground="#CBD5E1" FontSize="12" Margin="0,4" Cursor="Hand" MouseLeftButtonDown="BtnSupport_Click"/>
                        <TextBlock Text="📜 View Logs" Foreground="#CBD5E1" FontSize="12" Margin="0,4" Cursor="Hand" MouseLeftButtonDown="NavLogs_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel x:Name="SidebarNav" Margin="0,10,0,0">
                    <Button x:Name="NavOverview" Click="NavOverview_Click" Style="{StaticResource SidebarBtnActive}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Overview" Foreground="#004AC6" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavScanner" Click="NavScanner_Click" Style="{StaticResource SidebarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔌" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Scanner" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavFingerprint" Click="NavFingerprint_Click" Style="{StaticResource SidebarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👆" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Fingerprint Test" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavServiceStatus" Click="NavServiceStatus_Click" Style="{StaticResource SidebarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💚" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Service Status" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavLogs" Click="NavLogs_Click" Style="{StaticResource SidebarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Activity Logs" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Click="NavSettings_Click" Style="{StaticResource SidebarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAbout" Click="NavAbout_Click" Style="{StaticResource SidebarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="About" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Main Container -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1" Padding="24,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPageTitle" Text="Overview" FontSize="18" FontWeight="Bold" Foreground="#191C1E" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Diagnostic Mode" Foreground="#434655" FontSize="13" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NavServiceStatus_Click"/>
                        <TextBlock Text="Terminal" Foreground="#434655" FontSize="13" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NavLogs_Click"/>
                        <Border Width="1" Height="20" Background="#C3C6D7" Margin="0,0,20,0"/>
                        <TextBlock Text="🔔" FontSize="16" Margin="0,0,16,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="BtnNotification_Click"/>
                        <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="BtnProfile_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ PAGE: OVERVIEW ============ -->
            <ScrollViewer x:Name="PageOverview" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel Margin="32">
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="High-Q Biometric Service" FontSize="28" FontWeight="Bold" Foreground="#191C1E"/>
                        <TextBlock Text="Fingerprint hardware bridge for High-Q Attendance." FontSize="14" Foreground="#434655" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E1E2E4" BorderThickness="1" Padding="24" Margin="0,0,12,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#E0F2FE" BorderBrush="#004AC6" BorderThickness="2" Margin="0,0,16,0">
                                        <TextBlock Text="✓" Foreground="#004AC6" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Service Running" FontSize="20" FontWeight="Bold" Foreground="#191C1E"/>
                                        <TextBlock Text="All core processes active" FontSize="13" Foreground="#515F74"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                        <TextBlock Text="Service Status" FontSize="12" FontWeight="SemiBold" Foreground="#434655"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="8" Height="8" Fill="#004AC6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Running" FontSize="14" FontWeight="SemiBold" Foreground="#191C1E"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                        <TextBlock Text="API Status" FontSize="12" FontWeight="SemiBold" Foreground="#434655"/>
                                        <TextBlock Text="Online" FontSize="14" FontWeight="SemiBold" Foreground="#191C1E" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Port Binding" FontSize="12" FontWeight="SemiBold" Foreground="#434655"/>
                                        <Border Background="#F3F4F6" BorderBrush="#E1E2E4" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <TextBlock Text="http://localhost:8080" FontFamily="Consolas" FontSize="12" Foreground="#191C1E"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Version / Uptime" FontSize="12" FontWeight="SemiBold" Foreground="#434655"/>
                                        <TextBlock Text="1.0.0 • Active" FontSize="14" Foreground="#191C1E" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E1E2E4" BorderThickness="1" Padding="24" Margin="12,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse Width="8" Height="8" Fill="#004AC6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Scanner Connected" FontSize="12" FontWeight="Bold" Foreground="#004AC6"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtReaderName" Text="DigitalPersona U.are.U 5160" FontSize="18" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,16"/>
                                <StackPanel>
                                    <Border Padding="0,8" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1">
                                        <DockPanel><TextBlock Text="Connection" FontSize="13" Foreground="#434655"/><TextBlock Text="USB 3.0" FontSize="12" FontWeight="SemiBold" Foreground="#191C1E" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    </Border>
                                    <Border Padding="0,8" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1">
                                        <DockPanel><TextBlock Text="Driver" FontSize="13" Foreground="#434655"/><TextBlock Text="Installed (v3.2.1)" FontSize="12" FontWeight="SemiBold" Foreground="#191C1E" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    </Border>
                                    <Border Padding="0,8">
                                        <DockPanel><TextBlock Text="SDK Status" FontSize="13" Foreground="#434655"/><Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="Ready" FontSize="12" FontWeight="Bold" Foreground="#004AC6"/></Border></DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="#0D1C2E" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="16" Margin="0,0,0,24">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="LIVE SERVICE TERMINAL LOGS" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ScrollViewer x:Name="LogScrollViewer" Height="140" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🔬 Test Scanner" Click="BtnSimulate_Click" Background="#004AC6" Foreground="White" FontWeight="Bold" Padding="24,10" BorderThickness="0" Margin="0,0,16,0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                        <Button Content="↗ Open Attendance System" Click="BtnOpenSystem_Click" Background="Transparent" Foreground="#191C1E" FontWeight="SemiBold" Padding="20,10" BorderBrush="#C3C6D7" BorderThickness="1" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ PAGE: SCANNER ============ -->
            <ScrollViewer x:Name="PageScanner" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Margin="32">
                    <TextBlock Text="Scanner Hardware" FontSize="28" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,8"/>
                    <TextBlock Text="Detailed information about your connected DigitalPersona device." FontSize="14" Foreground="#434655" Margin="0,0,0,24"/>
                    <Border Background="White" CornerRadius="8" BorderBrush="#E1E2E4" BorderThickness="1" Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Device Information" FontSize="16" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,16"/>
                            <Border Padding="0,10" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Device Name" Foreground="#434655"/><TextBlock Text="DigitalPersona U.are.U 5160" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel></Border>
                            <Border Padding="0,10" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Connection Type" Foreground="#434655"/><TextBlock Text="USB 3.0" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel></Border>
                            <Border Padding="0,10" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Driver Version" Foreground="#434655"/><TextBlock Text="v3.2.1" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel></Border>
                            <Border Padding="0,10" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Serial Number" Foreground="#434655"/><TextBlock Text="DP-5160-HQ-001" FontFamily="Consolas" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel></Border>
                            <Border Padding="0,10"><DockPanel><TextBlock Text="Firmware" Foreground="#434655"/><TextBlock Text="2.0.4-stable" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel></Border>
                        </StackPanel>
                    </Border>
                    <Button Content="🔄 Reconnect Scanner" Click="BtnReconnect_Click" Background="#004AC6" Foreground="White" FontWeight="Bold" Padding="24,10" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ PAGE: FINGERPRINT TEST ============ -->
            <ScrollViewer x:Name="PageFingerprint" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Margin="32">
                    <TextBlock Text="Fingerprint Test" FontSize="28" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,8"/>
                    <TextBlock Text="Place your finger on the scanner to test biometric capture." FontSize="14" Foreground="#434655" Margin="0,0,0,24"/>
                    <Border Background="White" CornerRadius="8" BorderBrush="#E1E2E4" BorderThickness="1" Padding="32" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="120" Height="120" CornerRadius="60" Background="#E0F2FE" BorderBrush="#004AC6" BorderThickness="3" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="👆" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Waiting for fingerprint..." FontSize="16" FontWeight="SemiBold" Foreground="#434655" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Touch the scanner when ready" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <Button Content="🔬 Simulate Scan" Click="BtnSimulate_Click" Background="#004AC6" Foreground="White" FontWeight="Bold" Padding="24,10" BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ PAGE: SERVICE STATUS ============ -->
            <ScrollViewer x:Name="PageServiceStatus" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Margin="32">
                    <TextBlock Text="Service Status" FontSize="28" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,8"/>
                    <TextBlock Text="HTTP server and API endpoint health monitoring." FontSize="14" Foreground="#434655" Margin="0,0,0,24"/>
                    <Border Background="White" CornerRadius="8" BorderBrush="#E1E2E4" BorderThickness="1" Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="HTTP Server" FontSize="16" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,16"/>
                            <Border Padding="0,10" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Endpoint" Foreground="#434655"/><Border Background="#F3F4F6" CornerRadius="4" Padding="8,2" DockPanel.Dock="Right"><TextBlock Text="http://localhost:8080" FontFamily="Consolas" FontSize="12"/></Border></DockPanel></Border>
                            <Border Padding="0,10" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="CORS Headers" Foreground="#434655"/><TextBlock Text="Allow-Origin: *" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel></Border>
                            <Border Padding="0,10" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Status" Foreground="#434655"/><Border Background="#DCFCE7" CornerRadius="4" Padding="8,2" DockPanel.Dock="Right"><TextBlock Text="🟢 Online" FontWeight="Bold" Foreground="#166534" FontSize="12"/></Border></DockPanel></Border>
                            <Border Padding="0,10"><DockPanel><TextBlock Text="Memory Usage" Foreground="#434655"/><TextBlock Text="~25 MB" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel></Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ PAGE: ACTIVITY LOGS ============ -->
            <ScrollViewer x:Name="PageLogs" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Margin="32">
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Activity Logs" FontSize="28" FontWeight="Bold" Foreground="#191C1E"/>
                            <TextBlock Text="Full service log stream with timestamps." FontSize="14" Foreground="#434655" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="📋 Export Log" Click="BtnExportLog_Click" Background="Transparent" Foreground="#191C1E" FontWeight="SemiBold" Padding="16,8" BorderBrush="#C3C6D7" BorderThickness="1" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                    </DockPanel>
                    <Border Background="#0D1C2E" CornerRadius="8" Padding="16">
                        <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtLogFull" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ PAGE: SETTINGS ============ -->
            <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Margin="32">
                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,8"/>
                    <TextBlock Text="Configure biometric service behavior." FontSize="14" Foreground="#434655" Margin="0,0,0,24"/>
                    <Border Background="White" CornerRadius="8" BorderBrush="#E1E2E4" BorderThickness="1" Padding="24">
                        <StackPanel>
                            <Border Padding="0,12" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1">
                                <DockPanel><StackPanel><TextBlock Text="API Port" FontWeight="SemiBold"/><TextBlock Text="Port used by the local HTTP API server" FontSize="12" Foreground="#434655"/></StackPanel><Border Background="#F3F4F6" CornerRadius="4" Padding="12,6" DockPanel.Dock="Right"><TextBlock Text="8080" FontFamily="Consolas" FontWeight="Bold"/></Border></DockPanel>
                            </Border>
                            <Border Padding="0,12" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1">
                                <DockPanel><StackPanel><TextBlock Text="Auto-start with Windows" FontWeight="SemiBold"/><TextBlock Text="Launch biometric service on system boot" FontSize="12" Foreground="#434655"/></StackPanel><CheckBox IsChecked="True" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
                            </Border>
                            <Border Padding="0,12">
                                <DockPanel><StackPanel><TextBlock Text="Minimize to System Tray" FontWeight="SemiBold"/><TextBlock Text="Hide window to tray instead of closing" FontSize="12" Foreground="#434655"/></StackPanel><CheckBox IsChecked="True" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ PAGE: ABOUT ============ -->
            <ScrollViewer x:Name="PageAbout" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Margin="32">
                    <TextBlock Text="About" FontSize="28" FontWeight="Bold" Foreground="#191C1E" Margin="0,0,0,8"/>
                    <TextBlock Text="High-Q Biometric Service information." FontSize="14" Foreground="#434655" Margin="0,0,0,24"/>
                    <Border Background="White" CornerRadius="8" BorderBrush="#E1E2E4" BorderThickness="1" Padding="24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Width="48" Height="48" CornerRadius="10" Background="#004AC6" Margin="0,0,16,0">
                                    <TextBlock Text="🖐️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="High-Q Biometric Service" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Version 1.0.0" FontSize="13" Foreground="#434655"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Padding="0,10" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Publisher" Foreground="#434655"/><TextBlock Text="High-Q Solid Academy" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel></Border>
                            <Border Padding="0,10" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Framework" Foreground="#434655"/><TextBlock Text=".NET 8.0 / WPF" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel></Border>
                            <Border Padding="0,10" BorderBrush="#E1E2E4" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Scanner SDK" Foreground="#434655"/><TextBlock Text="DigitalPersona U.are.U SDK" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel></Border>
