<Window x:Class="HighQBiometricService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="High-Q Solid Academy - Biometric Service" Height="550" Width="850"
        WindowStartupLocation="CenterScreen" Background="#0F172A"
        Icon="icon.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="#FDC014" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="HQ" Foreground="#0F172A" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="High-Q Solid Academy" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Local Biometric Hardware Service (DigitalPersona U.are.U SDK)" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#334155" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="Service Active on Port 8080" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hardware Reader Status -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Reader Info -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="15" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="HARDWARE SCANNER" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtReaderName" Text="DigitalPersona U.are.U 5160" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtReaderStatus" Text="Connected &amp; Ready" Foreground="#22C55E" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Local API Endpoint -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="15" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="LOCAL SERVICE ENDPOINT" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="http://localhost:8080" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Web Application Connected" Foreground="#22C55E" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Total Scans -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="15" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="TOTAL FINGERPRINT SCANS" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTotalScans" Text="0" Foreground="#FDC014" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Real-Time Activity Terminal Log -->
        <Border Grid.Row="2" Background="#020617" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LIVE BIOMETRIC HARDWARE LOGS" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" 
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Footer Bar -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="High-Q Solid Academy Biometric System &copy; 2026. Keep service running on attendance terminal." Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Minimize to System Tray" Click="BtnMinimize_Click" Background="#334155" Foreground="#F8FAFC" Padding="12,6" BorderThickness="0" Margin="0,0,8,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Simulate Finger Scan" Click="BtnSimulate_Click" Background="#FDC014" Foreground="#0F172A" FontWeight="Bold" Padding="12,6" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
