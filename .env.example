# High-Q Solid Academy Biometric Attendance System - Environment Configuration Example
# Copy this file to .env and configure your environment settings

APP_ENV=local
APP_DEBUG=true

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=highqsol_highq
DB_USER=root
DB_PASS=

# Default Kiosk Terminal PIN (Default: 1234)
TERMINAL_PIN=1234

# Main Academy Site URLs
MAIN_SITE_URL=https://highqsolidacademy.com
MAIN_ADMIN_URL=https://admin.highqsolidacademy.com

# Kiosk Master Emergency Key (Recovery Key)
TERMINAL_MASTER_RECOVERY_KEY=HQ-MASTER-RECOVER-2026

# Admin Contact & Support
SUPPORT_EMAIL=admin@highqsoldacademy.com
